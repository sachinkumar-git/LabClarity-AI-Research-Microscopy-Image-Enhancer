# Used by docker-compose.yml only. Copy to .env and fill in. Never commit .env.

# Shared secret between gateway and AI service (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_TOKEN=

# Public URL the browser uses (for CORS) and host port for the web UI
PUBLIC_ORIGIN=http://localhost:8080
FRONTEND_PORT=8080

# PyTorch wheel index: CPU by default; for NVIDIA use https://download.pytorch.org/whl/cu126
TORCH_INDEX=https://download.pytorch.org/whl/cpu
DEVICE=auto
TILE_SIZE=256
MAX_INPUT_PIXELS=2000000
