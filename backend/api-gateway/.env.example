# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB connection string (Atlas or local), e.g. mongodb://127.0.0.1:27017/labclarity
MONGODB_URI=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Python AI service; token must match AI_SERVICE_TOKEN in backend/ai-service/.env
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=300000

MAX_UPLOAD_MB=25
MAX_BATCH_FILES=10
STORAGE_DIR=./storage
JOB_CONCURRENCY=1
# Ad-hoc uploads (no experiment) expire after this many hours; experiment data is kept
JOB_RETENTION_HOURS=24

RATE_LIMIT_WINDOW_MS=900000
# Writes (POST/PATCH/DELETE) and reads (GET, polled by the UI) have separate budgets
RATE_LIMIT_MAX=300
RATE_LIMIT_READ_MAX=3000
UPLOAD_RATE_LIMIT_MAX=20
# Number of reverse proxies in front of the app (0 when exposed directly)
TRUST_PROXY=0
