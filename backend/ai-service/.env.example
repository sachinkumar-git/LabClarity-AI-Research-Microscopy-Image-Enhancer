# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Shared secret with the Node gateway (>= 32 chars, required in production)
AI_SERVICE_TOKEN=

# Where the .pth weight files live (relative to backend/ai-service)
WEIGHTS_DIR=weights

# auto | cpu | cuda
DEVICE=auto
USE_FP16=true

# Tiled inference: lower TILE_SIZE if you hit GPU out-of-memory. 0 disables tiling.
TILE_SIZE=256
TILE_OVERLAP=16

MAX_UPLOAD_MB=25
MAX_INPUT_PIXELS=2000000
MAX_CONCURRENT_JOBS=1
MODEL_CACHE_SIZE=1
